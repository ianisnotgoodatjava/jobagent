GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Applications

# A model, for the steps that research and write (auto-draft, find-jobs,
# follow-ups, the agent pass). Any ONE of these is enough; with several, a
# failure on one falls through to the next. `python cli.py llm-status` shows
# what is ready. Everything else runs without a model.
#
#  1. Meta's Muse Spark. Get a key at https://dev.meta.ai
MODEL_API_KEY=your_meta_model_api_key_here
# MUSE_MODEL=muse-spark-1.3
#  2. Claude, metered API key from https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
#  3. Claude, on a Claude subscription: nothing to set here. Install Claude
#     Code and sign in (`claude`, then /login).
#
# Optional: force the order, e.g. LLM_PROVIDER=claude_cli,muse
# LLM_PROVIDER=
# Optional: a different Claude model for 2 and 3. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Your own addresses, comma-separated. Used to tell your messages from other
# people's in a thread. Falls back to profile.email in resume_bank.json.
OWN_EMAIL=you@example.com
# Optional: your display name, if mail goes out under more than one address.
OWN_NAME=Your Name
